rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── CMS collections ─────────────────────────────────────────────────────
    // Path: /cms/{collectionName}/items/{docId}
    // Anyone can read (portfolio is public). Only authenticated admin can write.
    match /cms/{collectionName}/items/{docId} {
      allow read: if true;
      allow create: if isAdmin() && validWrite();
      allow update: if isAdmin() && validWrite();
      allow delete: if isAdmin();
    }

    // ── UI Singletons ────────────────────────────────────────────────────────
    // Path: /cms_ui/{docId}  (e.g. main_intro, spotify)
    match /cms_ui/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Deny everything else by default ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helper functions ─────────────────────────────────────────────────────

    // isAdmin: must be signed in (single-admin portfolio, no email_verified needed)
    function isAdmin() {
      return request.auth != null;
    }

    // validWrite: single document size guard (1 MiB max, covers all fields)
    function validWrite() {
      return request.resource.size() < 1048576;
    }
  }
}
